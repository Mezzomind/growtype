{
  "name": "@growtype/react",
  "version": "0.1.0",
  "description": "React component and hooks for growtype: text sprouting out of an SVG path.",
  "keywords": [
    "animation",
    "react",
    "svg",
    "text-on-path",
    "typography"
  ],
  "homepage": "https://github.com/courdek/growtype/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/courdek/growtype/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/courdek/growtype.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
