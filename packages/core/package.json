{
  "name": "growtype",
  "version": "0.2.2",
  "description": "Grow text out of an SVG path like little mold spores.",
  "keywords": [
    "animation",
    "generative",
    "svg",
    "text-on-path",
    "typography"
  ],
  "homepage": "https://github.com/Mezzomind/growtype/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Mezzomind/growtype/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mezzomind/growtype.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "opentype.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/opentype.js": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
