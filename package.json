{
  "name": "growtype-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run playground#dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "release:check": "node scripts/check-release.mjs",
    "release:pack": "rm -rf .release && pnpm --filter \"./packages/*\" pack --pack-destination .release"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.0"
}
